---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate } from "../utils";

const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const proyectos = (await getCollection("proyectos", (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "gdols.dev",
      url: "https://gdols.dev/",
      inLanguage: "es",
    },
    {
      "@type": "Person",
      name: "Guille Dols",
      url: "https://gdols.dev/",
      email: "mailto:guille@gdols.dev",
      jobTitle: "Full stack developer",
      knowsAbout: [".NET", "Blazor", "SQL Server", "Azure", "Data Science", "Android", "APIs"],
      sameAs: [
        "https://github.com/gdols",
        "https://www.linkedin.com/in/guillermodols/",
      ],
    },
  ],
});
---
<Base>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <div class="home">
    <div class="home-intro">
      <h1>Hola, soy Guille</h1>
      <p class="lead">
        Desarrollador full stack, principalmente con .NET, Blazor y SQL Server.
        También trabajo con Azure y estudio el Grado de Data Science.
      </p>
      <p>
        Esta web es donde voy dejando proyectos y notas de cosas que me ha
        costado resolver o que no quiero volver a buscar. Si a alguien más le
        sirven, mejor.
      </p>
    </div>

    {posts.length > 0 && (
      <section class="home-section" aria-labelledby="home-notas">
        <p class="home-label" id="home-notas">Últimas notas</p>
        <ul class="list">
          {posts.map((p) => (
            <li>
              <div class="row">
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
              </div>
              {p.data.summary && <p>{p.data.summary}</p>}
            </li>
          ))}
        </ul>
        <p class="home-all"><a href="/blog/">Todas las notas</a></p>
      </section>
    )}

    {proyectos.length > 0 && (
      <section class="home-section" aria-labelledby="home-proyectos">
        <p class="home-label" id="home-proyectos">Proyectos</p>
        <ul class="list">
          {proyectos.map((p) => (
            <li>
              <div class="row">
                {p.data.page || p.data.repo || p.data.demo ? (
                  <a href={p.data.page ?? p.data.repo ?? p.data.demo}>{p.data.title}</a>
                ) : (
                  <strong>{p.data.title}</strong>
                )}
                {p.data.tech.length > 0 && (
                  <span class="meta">{p.data.tech.join(" · ")}</span>
                )}
              </div>
              <p>{p.data.description}</p>
              {p.data.download && (
                <p class="home-dl"><a href={p.data.download}>Descargar</a></p>
              )}
            </li>
          ))}
        </ul>
        <p class="home-all"><a href="/proyectos/">Todos los proyectos</a></p>
      </section>
    )}
  </div>
</Base>
