---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate } from "../utils";

const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const proyectos = (await getCollection("proyectos", (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "gdols.dev",
      url: "https://gdols.dev/",
      inLanguage: "es",
    },
    {
      "@type": "Person",
      name: "Guille Dols",
      url: "https://gdols.dev/",
      email: "mailto:guille@gdols.dev",
      jobTitle: "Full stack developer",
      knowsAbout: [".NET", "Blazor", "SQL Server", "Azure", "Data Science", "Android", "APIs"],
      sameAs: [
        "https://github.com/gdols",
        "https://www.linkedin.com/in/guillermodols/",
      ],
    },
  ],
});
---
<Base ancho="medio">
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <section class="intro">
    <h1>Desarrollador full stack, principalmente con .NET, Blazor y SQL Server.</h1>
    <p>
      También trabajo con Azure y estudio el Grado de Data Science. Esta web es
      donde voy dejando proyectos y notas de cosas que me ha costado resolver o
      que no quiero volver a buscar. Si a alguien más le sirven, mejor.
    </p>
    <p class="intro-contacto">
      <a href="mailto:guille@gdols.dev">guille@gdols.dev</a>
      <a href="https://github.com/gdols">GitHub</a>
      <a href="https://www.linkedin.com/in/guillermodols/">LinkedIn</a>
    </p>
  </section>

  {posts.length > 0 && (
    <section class="indice" aria-labelledby="home-notas">
      <h2 id="home-notas">Notas</h2>
      <ul>
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          </li>
        ))}
      </ul>
      <p class="indice-mas"><a href="/blog/">Todas las notas</a></p>
    </section>
  )}

  {proyectos.length > 0 && (
    <section class="indice" aria-labelledby="home-proyectos">
      <h2 id="home-proyectos">Proyectos</h2>
      <ul>
        {proyectos.map((p) => {
          const principal = p.data.page ?? p.data.demo ?? p.data.repo;
          return (
            <li>
              {principal ? <a href={principal}>{p.data.title}</a> : <span>{p.data.title}</span>}
              <span class="indice-desc">{p.data.description}</span>
            </li>
          );
        })}
      </ul>
      <p class="indice-mas"><a href="/proyectos/">Todos los proyectos</a></p>
    </section>
  )}
</Base>
