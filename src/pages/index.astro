---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TarjetaNota from "../components/TarjetaNota.astro";
import TarjetaProyecto from "../components/TarjetaProyecto.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const proyectos = (await getCollection("proyectos", (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);

// La ventana de código de la portada, ya coloreada
const perfil = [
  `<span class="c-k">var</span> guille = <span class="c-k">new</span> <span class="c-t">Desarrollador</span>`,
  `{`,
  `    Rol = <span class="c-s">"Full stack"</span>,`,
  `    Stack = [<span class="c-s">".NET"</span>, <span class="c-s">"Blazor"</span>,`,
  `             <span class="c-s">"SQL Server"</span>, <span class="c-s">"Azure"</span>],`,
  `    Estudiando = <span class="c-s">"Data Science"</span>,`,
  `    Equipo = <span class="c-s">"RCD Mallorca"</span>,`,
  `};`,
].join("\n");

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "gdols.dev",
      url: "https://gdols.dev/",
      inLanguage: "es",
    },
    {
      "@type": "Person",
      name: "Guille Dols",
      url: "https://gdols.dev/",
      email: "mailto:guille@gdols.dev",
      jobTitle: "Full stack developer",
      knowsAbout: [".NET", "Blazor", "SQL Server", "Azure", "Data Science", "Android", "APIs"],
      sameAs: [
        "https://github.com/gdols",
        "https://www.linkedin.com/in/guillermodols/",
      ],
    },
  ],
});
---
<Base ancho="pagina">
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <section class="hero">
    <div class="hero-texto">
      <p class="antetitulo">Full stack developer</p>
      <h1>Hola, soy <span class="degradado">Guille</span></h1>
      <p class="lead">
        Desarrollador full stack, principalmente con .NET, Blazor y SQL Server.
        También trabajo con Azure y estudio el Grado de Data Science.
      </p>
      <p>
        Esta web es donde voy dejando proyectos y notas de cosas que me ha
        costado resolver o que no quiero volver a buscar. Si a alguien más le
        sirven, mejor.
      </p>
      <p class="acciones">
        <a class="boton" href="/blog/">Leer las notas</a>
        <a class="boton boton-secundario" href="/proyectos/">Ver proyectos</a>
      </p>
      <p class="enlaces-sociales">
        <a href="https://github.com/gdols">GitHub</a>
        <a href="https://www.linkedin.com/in/guillermodols/">LinkedIn</a>
        <a href="mailto:guille@gdols.dev">Correo</a>
        <a href="/rss.xml">RSS</a>
      </p>
    </div>

    <div class="ventana-codigo" aria-hidden="true">
      <div class="ventana-barra">
        <span></span><span></span><span></span>
        <p>Guille.cs</p>
      </div>
      <pre><code set:html={perfil} /></pre>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="seccion" aria-labelledby="home-notas">
      <div class="seccion-cabecera">
        <h2 id="home-notas">Últimas notas</h2>
        <a class="ver-todo" href="/blog/">Todas las notas</a>
      </div>
      <div class="rejilla rejilla-3">
        {posts.map((p) => <TarjetaNota post={p} />)}
      </div>
    </section>
  )}

  {proyectos.length > 0 && (
    <section class="seccion" aria-labelledby="home-proyectos">
      <div class="seccion-cabecera">
        <h2 id="home-proyectos">Proyectos</h2>
        <a class="ver-todo" href="/proyectos/">Todos los proyectos</a>
      </div>
      <div class="rejilla rejilla-2">
        {proyectos.map((p) => <TarjetaProyecto proyecto={p} />)}
      </div>
    </section>
  )}
</Base>
