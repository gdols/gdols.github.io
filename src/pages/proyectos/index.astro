---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import TarjetaProyecto from "../../components/TarjetaProyecto.astro";

const proyectos = (await getCollection("proyectos"))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Proyectos" description="Cosas que he hecho: .NET, Blazor, SQL y algún experimento." ancho="pagina">
  <header class="cabecera-pagina">
    <p class="antetitulo">{proyectos.length} proyectos</p>
    <h1>Proyectos</h1>
    <p class="lead">Cosas que he hecho: .NET, Blazor, SQL y algún experimento.</p>
  </header>

  {proyectos.length === 0 ? (
    <p class="muted">Aún no hay nada por aquí.</p>
  ) : (
    <div class="rejilla rejilla-2">
      {proyectos.map((p) => <TarjetaProyecto proyecto={p} />)}
    </div>
  )}
</Base>
